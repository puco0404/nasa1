```gitignore
# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
*.min.js
*.min.css
*.bundle.js

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.python-version
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/refs/original/
install_manifest.txt
.manifest
*.manifest
*.mo
*.pot
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage*
.eggs/
.egg-info/
```